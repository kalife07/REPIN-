# REPIN' backend settings
# This file is read automatically when the backend starts (python -m app.app).
# Template: copy this file to .env and adjust the values.

# Address the backend listens on (127.0.0.1 = only this computer)
FLASK_RUN_HOST=127.0.0.1

# Port the backend listens on.
# If you change it, also update the API URLs in frontend/script.js.
FLASK_RUN_PORT=5000

# Debug mode: auto-reloads on code changes and shows detailed errors.
# Set to false in production.
FLASK_DEBUG=true

# Websites allowed to call the API, separated by commas (* = any website)
# Example: CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
CORS_ORIGINS=*
